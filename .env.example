# Modèle de configuration : copier vers .env, ignoré par Git.
# Ces variables seront consommées par les services des tâches suivantes.
# Valeurs vides : renseigner localement, aucun secret de démonstration partagé.

POSTGRES_DB=saamstiahf
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_API_PASSWORD=
APP_WORKER_PASSWORD=
# Connexions séparées conformément aux privilèges de schema.sql.
DATABASE_URL_API=
DATABASE_URL_WORKER=
# Compte administrateur réservé aux migrations ; jamais injecté dans l'API.
DATABASE_URL_MIGRATIONS=

# Clé de signature JWT et clé AES-256-GCM de 32 octets.
# ARTIFACT_KEY : 32 octets représentés par 64 caractères hexadécimaux (T3.2).
JWT_SECRET=
AUTH_ORIGIN=https://localhost
ARTIFACT_KEY=
ARTIFACT_KEY_FILE=
ARTIFACT_ROOT=/data/artifacts
UPLOAD_ROOT=/data/uploads

LEDGER_GATEWAY_URL=http://ledger-gateway:8080
# Passerelle : fichier JSON identité du wallet → jeton, hors Git.
AGENT_TOKEN_FILE=
# Jetons distincts, mappés aux identités Fabric par la passerelle.
AGENT_TOKEN_INGESTION=
AGENT_TOKEN_PREPARATION=
AGENT_TOKEN_FEATURES=
AGENT_TOKEN_PREDICTION=
AGENT_TOKEN_VALIDATION=
AGENT_TOKEN_EXPLANATION=
AGENT_TOKEN_FINALIZATION=
AGENT_TOKEN_VERIFIER=
AGENT_TOKEN_MODEL_ADMIN=

WORKER_CONCURRENCY=1
LLM_EXPLANATION_ENABLED=false

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_EMAIL=
SEED_OPERATOR_PASSWORD=
SEED_AUDITOR_EMAIL=
SEED_AUDITOR_PASSWORD=

# Ports de nginx sur localhost (valeurs par défaut : 80 et 443).
HTTP_PORT=80
HTTPS_PORT=443
