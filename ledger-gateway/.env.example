# Jeton de service hors git. JSON : { "agent-ingestion": "<jeton>", ... }
# Les clés sont les noms d'identité du wallet. L'en-tête HTTP est X-Agent-Token.
AGENT_TOKEN_FILE=

# Facultatifs. Une valeur vide est lue comme absente ; la valeur par défaut s'applique.
# Wallet des identités Fabric (défaut : fabric/wallet du dépôt).
# WALLET_DIR=
# Certificat TLS du pair (défaut : peer0-org1-tls-ca.crt dans le wallet).
# PEER_TLS_CERT=
PEER_ENDPOINT=localhost:18051
CHANNEL_NAME=medtrace
CHAINCODE_NAME=provenance
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
