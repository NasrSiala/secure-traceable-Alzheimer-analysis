{
  "name": "provenance",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "test": "node node_modules/typescript/bin/tsc --noEmit && node -e \"require('fs').rmSync('dist-test',{recursive:true,force:true})\" && node node_modules/typescript/bin/tsc -p tsconfig.test.json && node node_modules/jest/bin/jest.js --runInBand",
    "start": "fabric-chaincode-node server --chaincode-address ${CHAINCODE_SERVER_ADDRESS:-0.0.0.0:9999} --chaincode-id ${CHAINCODE_ID:?CHAINCODE_ID is required}"
  },
  "dependencies": {
    "fabric-contract-api": "2.5.8",
    "fabric-shim": "2.5.8",
    "reflect-metadata": "0.1.14"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.17.6",
    "jest": "29.7.0",
    "typescript": "5.6.3"
  },
  "overrides": {
    "deepmerge": "4.1.2"
  }
}
